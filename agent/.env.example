# Copy this file to `.env` and fill in ONE model key. Free tiers first.
# The agent picks the first key it finds, in the order listed in src/llm.js.

# ---- Genuinely free tiers ----
# Groq — fastest free option. https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — generous free tier. https://aistudio.google.com/apikey
GEMINI_API_KEY=

# OpenRouter — free models carry a `:free` suffix. https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Cerebras — free tier. https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# ---- Paid (no free tier, but cheap for this job) ----
# DeepSeek — cheapest paid option. https://platform.deepseek.com
DEEPSEEK_API_KEY=

# OpenAI / ChatGPT — paid only. https://platform.openai.com/api-keys
OPENAI_API_KEY=

# xAI / Grok — paid only. https://console.x.ai
XAI_API_KEY=

# Anthropic / Claude — paid only. https://console.anthropic.com
ANTHROPIC_API_KEY=


# ---- Optional job sources that need a free key ----
# Adzuna — free tier, real listings for UK/US/ZA/IN/AU etc (no Nigeria coverage).
# https://developer.adzuna.com
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# JSearch on RapidAPI — Google Jobs data, free tier ~200 requests/month.
# This is the one source with genuine Nigeria coverage. https://rapidapi.com/letscrape-6bRBa3QguO5/api/jsearch
RAPIDAPI_KEY=
